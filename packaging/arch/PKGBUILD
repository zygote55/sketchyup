# Development archive package. Generate the source archive with scripts/package-source.sh.
pkgname=sketchyup
pkgver=0.1.0
pkgrel=2
pkgdesc='Experimental native Linux face modeler'
arch=('x86_64')
url='https://github.com/zygote55/sketchyup'
license=('MIT' 'BSL-1.0' 'Apache-2.0')
depends=('openssl' 'qt6-base' 'qt6-wayland' 'wayland' 'shared-mime-info' 'ttf-dejavu')
optdepends=('libsecret: OpenAI credential storage through the desktop Secret Service'
            'blender: optional rendered images, animation frames and Blender handoff')
# CMake configures Python-based recipe/reference checks when BUILD_TESTING is on.
makedepends=('cmake' 'ninja' 'gcc' 'pkgconf' 'python')
# makepkg's default LTO re-optimizes the static core for each of ~200 linked
# executables, turning a 15-minute build into hours. No debug split package ships.
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('REPLACE_WITH_SOURCE_SHA256') # Filled by package-source.sh.

build() {
  # GCC's -flto=auto can count host CPUs despite container CPU affinity. Keep
  # link-time compiler workers serial as well as Ninja's outer build jobs.
  local link_flags=$LDFLAGS
  if [[ "$CFLAGS $CXXFLAGS $LDFLAGS" == *-flto* ]]; then
    link_flags+=' -flto=1'
  fi
  cmake -S "$srcdir/$pkgname-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_EXE_LINKER_FLAGS="$link_flags" \
    -DCMAKE_SHARED_LINKER_FLAGS="$link_flags" \
    -DSKETCHYUP_NATIVE_FIXTURES_IN_ALL=OFF
  cmake --build build --parallel "${CMAKE_BUILD_PARALLEL_LEVEL:-1}"
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
