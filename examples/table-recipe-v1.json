            "id": {
              "$ref": "draw#/result/createdIds/recipeOperations/3/assembly"
            }
          },
          "space": "world"
        }
      }
    },
    {
      "id": "seal",
      "request": {
        "apiVersion": 1,
        "operation": "transaction.preview",
        "documentId": {
          "$ref": "info#/result/documentId"
        },
        "transactionId": {
          "$ref": "begin#/result/transactionId"
