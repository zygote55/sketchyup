      "request": {
        "apiVersion": 1,
        "operation": "session.describe"
      }
    },
    {
      "id": "begin",
      "request": {
        "apiVersion": 1,
        "operation": "transaction.begin",
        "documentId": {
          "$ref": "info#/result/documentId"
        },
        "expectedRevision": {
          "$ref": "info#/result/revision"
        },
        "history": {
          "label": "Create room, roof, stairs and table",
          "taskId": "table-recipe-v1",
          "assistant": false
        }
      }
    },
    {
      "id": "draw",
      "request": {
        "apiVersion": 1,
        "operation": "transaction.apply",
