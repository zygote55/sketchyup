ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('SketchyUp probe fixture: length unit metre, one 1 x 2 x 3 box = 6 m3'),'2;1');
FILE_NAME('units-m.ifc','2026-10-22T00:00:00',('SketchyUp'),('SketchyUp'),'SketchyUp R097.a','hand-written','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCPROJECT('0000000000000000000001',$,'Probe',$,$,$,$,(#10),#2);
#2=IFCUNITASSIGNMENT((#3,#4));
#3=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#4=IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);
#10=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#11,$);
#11=IFCAXIS2PLACEMENT3D(#12,$,$);
#12=IFCCARTESIANPOINT((0.,0.,0.));
#13=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#10,$,.MODEL_VIEW.,$);
#14=IFCDIRECTION((0.,0.,1.));
#15=IFCDIRECTION((1.,0.,0.));
#16=IFCCARTESIANPOINT((0.,0.));
#17=IFCAXIS2PLACEMENT2D(#16,$);
#120=IFCCARTESIANPOINT((0.0,0.0,0.0));
#121=IFCAXIS2PLACEMENT3D(#120,$,$);
#122=IFCLOCALPLACEMENT($,#121);
#123=IFCRECTANGLEPROFILEDEF(.AREA.,$,#17,1.0,2.0);
#124=IFCEXTRUDEDAREASOLID(#123,#11,#14,3.0);
#125=IFCSHAPEREPRESENTATION(#13,'Body','SweptSolid',(#124));
#126=IFCPRODUCTDEFINITIONSHAPE($,$,(#125));
#127=IFCBUILDINGELEMENTPROXY('P000000000000000000001',$,'box',$,$,#122,#126,$,$);
ENDSEC;
END-ISO-10303-21;
